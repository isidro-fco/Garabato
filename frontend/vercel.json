{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes pnpm@12.4.1 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@12.4.1 run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "https://garabato-api.onrender.com/api/:ruta*" },
    { "source": "/auth/:ruta*", "destination": "https://garabato-api.onrender.com/auth/:ruta*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
