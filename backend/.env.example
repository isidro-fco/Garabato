PORT=3000

# Neon: cadena de conexión de la base dev (en Render va la de prod)
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/garabato_dev?sslmode=verify-full

# Google Cloud → Credenciales → ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Llave de 32 bytes en base64 para la sesión. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
